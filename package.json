{
    "name": "vex-attendance-system",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun run _prebuild && bun build index.html --outdir=dist --sourcemap=external",
        "watch": "bun run _prebuild && bun build index.html --outdir=dist --sourcemap=external --watch",
        "_prebuild": "bun run _clean-dist && bun run _copy-assets && bun run _generate-events",
        "_clean-dist": "bun scripts/clean-dist.ts",
        "_copy-assets": "bun scripts/copy-assets.ts",
        "_generate-events": "bun scripts/generate-events.ts",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/node": "latest",
        "typescript": "latest"
    }
}