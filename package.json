{
    "name": "vex-attendance-system",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun run _prebuild && bun build index.html --outdir=dist --sourcemap=external --minify",
        "watch": "bun run _prebuild && bun build index.html --outdir=dist --sourcemap=external --minify --watch",
        "_prebuild": "bun run _clean-dist && bun run _pack-data",
        "_clean-dist": "bun scripts/clean-dist.ts",
        "_pack-data": "bun scripts/pack-data.ts",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/archiver": "^8.0.0",
        "@types/bun": "latest",
        "@types/node": "^26.6.6",
        "@types/qrcode": "^1.5.6",
        "archiver": "^8.0.0",
        "inherits": "^2.0.4",
        "minimatch": "^11.0.9",
        "typescript": "latest"
    },
    "dependencies": {
        "fflate": "^0.8.3",
        "jsqr": "^1.4.0",
        "qrcode": "^1.5.4",
        "scrypt-js": "^3.0.1"
    }
}