{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": [
            "ESNext",
            "DOM"
        ],
        "allowJs": false,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "bun",
            "node",
        ]
    },
    "include": [
        "lib/**/*.ts",
        "scripts/**/*.ts",
        "src/**/*.ts",
    ]
}